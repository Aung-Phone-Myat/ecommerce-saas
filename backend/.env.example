# Copy this file to .env and adjust values as needed.
# .env is git-ignored and must never be committed.
APP_NAME=Ecommerce SaaS API
VERSION=0.1.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------------------
# Supabase PostgreSQL
# ---------------------------------------------------------------------------
# Get the connection string from: Supabase Dashboard -> Connect.
# Then change the scheme from postgresql:// to postgresql+asyncpg:// and
# percent-encode reserved characters in the password (&, #, ?, spaces, etc.).
#
# Persistent backend on an IPv4 network (recommended here):
#   Session pooler, port 5432:
#   postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres
#
# Persistent backend with IPv6 available:
#   Direct connection, port 5432:
#   postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Serverless / edge functions:
#   Transaction pooler, port 6543, and set DB_DISABLE_PREPARED_STATEMENTS=true:
#   postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres
#
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres

# Supabase requires TLS. Set false only for a local PostgreSQL without SSL.
DB_SSL=true

# Required for the Supabase transaction pooler (port 6543). Keep false for
# the direct connection and the session pooler.
DB_DISABLE_PREPARED_STATEMENTS=false

# Application-side pool. Keep these small when using Supabase's pooler.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Set to true to log every SQL statement. Keep false outside debugging.
SQL_ECHO=false

# ---------------------------------------------------------------------------
# JWT authentication
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Keep this secret out of source control.
JWT_SECRET_KEY=replace-with-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
